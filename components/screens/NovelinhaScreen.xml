<?xml version="1.0" encoding="utf-8" ?>
<component name="NovelinhaScreen" extends="Group">
  <interface>
    <field id="item" type="assocarray" onChange="onItem" />
    <field id="exitRequested" type="boolean" value="false" alwaysNotify="true" />
    <function name="cleanUp" />
  </interface>
  <children>
    <Rectangle width="1920" height="1080" color="#000000" />
    <!-- Vídeo em pé (720x1280): centralizado, com faixas pretas dos lados. -->
    <Video id="video" width="1920" height="1080" translation="[0, 0]" enableUI="false" />
    <Group id="topo" translation="[60, 40]">
      <Rectangle width="900" height="140" color="#000000A0" />
      <Label id="titulo" translation="[30, 20]" width="840" color="#FFFFFF" text=""><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="38" /></Label>
      <Label id="episodio" translation="[30, 72]" width="840" color="#FFFFFFCC" text=""><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="28" /></Label>
      <Label translation="[30, 108]" width="840" color="#FFFFFF88" text="Cima e baixo trocam de episódio · OK pausa"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="22" /></Label>
    </Group>
    <Timer id="esconder" duration="4" repeat="false" />
  </children>
  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/NovelinhaScreen.brs" />
</component>
