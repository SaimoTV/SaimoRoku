<?xml version="1.0" encoding="utf-8" ?>
<component name="LiveScreen" extends="Group">
  <interface>
    <field id="channels" type="array" onChange="onChannelsChange" />
    <field id="epgMap" type="assocarray" onChange="onEpgChange" />
    <field id="currentChannelIndex" type="integer" value="0" onChange="onChannelIndexChange" />
    <field id="openDrawerOnLoad" type="boolean" value="false" />
    <function name="cleanUp" />
  </interface>

  <children>
    <!-- Player de Vídeo Nativo por Hardware -->
    <Video id="liveVideo" width="1920" height="1080" translation="[0, 0]" enableUI="false" />

    <!-- Indicador de Carregando / Buffer -->
    <Group id="bufferingGroup" translation="[840, 500]" visible="false">
      <Rectangle translation="[-40, -20]" width="300" height="80" color="#000000D0" />
      <Label text="Carregando canal..." color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="26" /></Label>
    </Group>

    <!-- ZapHUD (Mini Informações ao Trocar de Canal) -->
    <ZapHUD id="zapHud" />

    <!-- Dica de Acesso à Lista de Canais -->
    <Group id="drawerHintGroup" translation="[80, 1020]" visible="true">
      <Rectangle width="640" height="40" color="#0b0e14D0" />
      <Rectangle width="3" height="40" color="#4FE3D0" />
      <Label translation="[20, 10]" text="[OK] Canais  |  [Replay] Favoritar  |  [Cima/Baixo] Zapping" color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="22" /></Label>
    </Group>

    <!-- Toast de Favorito (*) -->
    <Group id="favoriteToast" translation="[760, 60]" visible="false">
      <Rectangle width="400" height="60" color="#0b0e14F0" />
      <Rectangle width="400" height="3" color="#FFB454" />
      <Label id="favoriteToastText" translation="[0, 18]" width="400" text="[*] Canal Favoritado" color="#FFB454" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
    </Group>
    <Timer id="favoriteToastTimer" duration="2.5" repeat="false" />

    <!-- Drawer Lateral de Canais -->
    <ChannelDrawer id="channelDrawer" />

    <!-- Modal de PIN Parental -->
    <PinModal id="pinModal" />
  </children>

  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/LiveScreen.brs" />
</component>
