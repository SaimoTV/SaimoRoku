<?xml version="1.0" encoding="utf-8" ?>
<component name="GuideScreen" extends="Group">
  <interface>
    <field id="channels" type="array" onChange="onChannelsChange" />
    <field id="epgMap" type="assocarray" onChange="onEpgChange" />
    <field id="tuneRequested" type="assocarray" alwaysNotify="true" />
    <field id="focusUpRequested" type="boolean" alwaysNotify="true" />
  </interface>

  <children>

    <!-- Coluna Esquerda: Canais -->
    <Group translation="[80, 100]">
      <Rectangle width="460" height="920" color="#111827" />
      <Rectangle width="460" height="3" color="#4FE3D0" />
      <Label translation="[24, 20]" text="CANAIS" color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="22" /></Label>

      <LabelList
        id="guideChannelList"
        translation="[16, 60]"
        itemSize="[428, 54]"
        itemSpacing="[0, 6]"
        numRows="14"
        wrap="false"
        color="#D5DCE5"
        focusedColor="#0b0e14"
        focusBitmapBlendColor="#4FE3D0"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="24" /><Font role="focusedFont" uri="pkg:/fonts/Roboto-Medium.ttf" size="24" /></LabelList>
    </Group>

    <!-- Coluna Direita: Grade do Canal Selecionado -->
    <Group translation="[560, 100]">
      <Rectangle width="1280" height="920" color="#111827" />
      <Rectangle width="1280" height="3" color="#7AA2FF" />
      <Label id="selectedChannelHeader" translation="[30, 20]" text="PROGRAMAÇÃO" color="#7AA2FF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="22" /></Label>

      <LabelList
        id="scheduleList"
        translation="[20, 60]"
        itemSize="[1240, 56]"
        itemSpacing="[0, 6]"
        numRows="13"
        wrap="false"
        color="#D5DCE5"
        focusedColor="#0b0e14"
        focusBitmapBlendColor="#4FE3D0"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="24" /><Font role="focusedFont" uri="pkg:/fonts/Roboto-Medium.ttf" size="24" /></LabelList>
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/components/screens/GuideScreen.brs" />
</component>
