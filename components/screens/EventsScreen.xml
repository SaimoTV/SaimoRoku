<?xml version="1.0" encoding="utf-8" ?>
<component name="EventsScreen" extends="Group">
  <interface>
    <field id="events" type="array" onChange="onEventsChange" />
    <field id="tuneRequested" type="string" alwaysNotify="true" />
    <field id="focusUpRequested" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <Rectangle width="1920" height="1080" color="#0b0e14" />

    <!-- Container da Lista de Jogos -->
    <Group translation="[80, 100]">
      <Rectangle width="1760" height="920" color="#111827" />
      <Rectangle width="1760" height="3" color="#4FE3D0" />
      <Label translation="[24, 20]" text="AGENDA ESPORTIVA DE HOJE • JOGOS AO VIVO" color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>

      <LabelList
        id="eventsList"
        translation="[20, 60]"
        itemSize="[1720, 64]"
        itemSpacing="[0, 6]"
        numRows="13"
        wrap="false"
        color="#94a3b8"
        focusedColor="#4FE3D0"
      />
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/components/screens/EventsScreen.brs" />
</component>
