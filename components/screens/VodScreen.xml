<?xml version="1.0" encoding="utf-8" ?>
<component name="VodScreen" extends="Group">
  <interface>
    <field id="vodItems" type="array" onChange="onItemsChange" />
    <field id="selectedCategory" type="string" value="Filmes" onChange="onCategoryChange" />
    <field id="itemSelected" type="assocarray" alwaysNotify="true" />
    <field id="playRequested" type="assocarray" alwaysNotify="true" />
    <field id="focusUpRequested" type="boolean" alwaysNotify="true" />
    <function name="cleanUp" />
  </interface>

  <children>
    <HeroBanner id="heroBanner" />
    <RowList
      id="vodRowList"
      itemComponentName="PosterItem"
      translation="[100, 430]"
      itemSize="[1820, 480]"
      rowHeights="[480]"
      rowItemSize="[[272, 460]]"
      rowItemSpacing="[[32, 0]]"
      itemSpacing="[0, 28]"
      showRowLabel="[true]"
      rowLabelOffset="[[12, 18]]"
      rowLabelColor="#FFFFFF"
      rowFocusAnimationStyle="floatingFocus"
      vertFocusAnimationStyle="fixedFocus"
      drawFocusFeedback="false"
      numRows="2"
      wrap="false"
    ><Font role="rowLabelFont" uri="pkg:/fonts/Roboto-Medium.ttf" size="36" /></RowList>
    <Timer id="heroTimer" duration="0.3" repeat="false" />

    <!-- Opções de um filtro (gênero, ano, idade, nota, ordem) -->
    <Group id="lista" visible="false">
      <Rectangle width="1920" height="1080" color="#000000B0" />
      <Poster translation="[560, 140]" width="800" height="800" uri="pkg:/images/p_branca.9.png" blendColor="#10141E" />
      <Label id="listaTitulo" translation="[620, 180]" width="680" text="" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="40" /></Label>
      <LabelList id="opcoes" translation="[620, 260]" itemSize="[680, 64]" numRows="10" vertFocusAnimationStyle="floatingFocus"
        color="#D5DCE5" focusedColor="#0B0E14" focusBitmapUri="pkg:/images/p_branca.9.png">
        <Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="30" />
        <Font role="focusedFont" uri="pkg:/fonts/Roboto-Medium.ttf" size="30" />
      </LabelList>
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/Rows.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/VodScreen.brs" />
</component>
