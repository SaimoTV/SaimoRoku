<?xml version="1.0" encoding="utf-8" ?>
<component name="VodScreen" extends="Group">
  <interface>
    <field id="vodItems" type="array" onChange="onItemsChange" />
    <field id="selectedCategory" type="string" value="Todos" onChange="onCategoryChange" />
    <field id="itemSelected" type="assocarray" alwaysNotify="true" />
    <field id="focusUpRequested" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <Rectangle width="1920" height="1080" color="#0b0e14" />

    <!-- Topo: 4 Categorias Oficiais (Filmes, Séries, Animes, Doramas) estilo TV Box -->
    <Group id="categoryChipsGroup" translation="[80, 85]">
      <!-- Chip 0: Filmes (#4FE3D0) -->
      <Group id="chip_0" translation="[0, 0]">
        <Rectangle id="chipBorder_0" translation="[-3, -3]" width="166" height="52" color="#FFFFFF" visible="true" />
        <Rectangle id="chipBg_0" width="160" height="46" color="#4FE3D0" />
        <Label id="chipText_0" translation="[0, 11]" width="160" text="Filmes" font="font:MediumBoldSystemFont" color="#0b0e14" horizAlign="center" />
      </Group>

      <!-- Chip 1: Séries (#7AA2FF) -->
      <Group id="chip_1" translation="[180, 0]">
        <Rectangle id="chipBorder_1" translation="[-3, -3]" width="166" height="52" color="#FFFFFF" visible="false" />
        <Rectangle id="chipBg_1" width="160" height="46" color="#1e293b" />
        <Label id="chipText_1" translation="[0, 11]" width="160" text="Séries" font="font:MediumBoldSystemFont" color="#94a3b8" horizAlign="center" />
      </Group>

      <!-- Chip 2: Animes (#FFB454) -->
      <Group id="chip_2" translation="[360, 0]">
        <Rectangle id="chipBorder_2" translation="[-3, -3]" width="166" height="52" color="#FFFFFF" visible="false" />
        <Rectangle id="chipBg_2" width="160" height="46" color="#1e293b" />
        <Label id="chipText_2" translation="[0, 11]" width="160" text="Animes" font="font:MediumBoldSystemFont" color="#94a3b8" horizAlign="center" />
      </Group>

      <!-- Chip 3: Doramas (#FF7EB6) -->
      <Group id="chip_3" translation="[540, 0]">
        <Rectangle id="chipBorder_3" translation="[-3, -3]" width="166" height="52" color="#FFFFFF" visible="false" />
        <Rectangle id="chipBg_3" width="160" height="46" color="#1e293b" />
        <Label id="chipText_3" translation="[0, 11]" width="160" text="Doramas" font="font:MediumBoldSystemFont" color="#94a3b8" horizAlign="center" />
      </Group>

      <!-- Instrução e Contador com Separação Garantida Sem Sobreposição -->
      <Label id="chipsHint" translation="[740, 12]" width="700" text="[Cima] Menu  |  [Baixo] Capas  |  [OK] Assistir" font="font:SmallSystemFont" color="#4FE3D0" />
      <Label id="vodCountLabel" translation="[1480, 12]" width="280" text="0 títulos" font="font:SmallBoldSystemFont" color="#94a3b8" horizAlign="right" />
    </Group>

    <!-- Grid de Posters Full Width GPU-Accelerated -->
    <PosterGrid
      id="vodPosterGrid"
      translation="[80, 150]"
      basePosterSize="[228, 342]"
      itemSpacing="[24, 28]"
      numColumns="7"
      numRows="3"
      caption1NumLines="1"
    />
  </children>

  <script type="text/brightscript" uri="pkg:/components/screens/VodScreen.brs" />
</component>
