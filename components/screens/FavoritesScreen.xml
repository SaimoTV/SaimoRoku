<?xml version="1.0" encoding="utf-8" ?>
<component name="FavoritesScreen" extends="Group">
  <interface>
    <field id="channels" type="array" onChange="refreshFavorites" />
    <field id="vodItems" type="array" onChange="refreshFavorites" />
    <field id="itemSelected" type="assocarray" alwaysNotify="true" />
    <field id="tuneRequested" type="assocarray" alwaysNotify="true" />
    <field id="focusUpRequested" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <Rectangle width="1920" height="1080" color="#0b0e14" />

    <!-- Cabeçalho -->
    <Group translation="[80, 85]">
      <Label text="MEUS FAVORITOS" color="#FFB454"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
      <Label id="countLabel" translation="[0, 24]" text="Seus canais, filmes e séries marcados com estrela" color="#94a3b8"><Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="22" /></Label>
    </Group>

    <!-- Trilhos de Favoritos (Canais e VOD) -->
    <RowList
      id="favoritesRowList"
      itemComponentName="PosterItem"
      translation="[80, 160]"
      itemSize="[1760, 340]"
      rowItemSize="[[180, 315]]"
      rowItemSpacing="[[24, 0]]"
      itemSpacing="[0, 35]"
      showRowLabel="[true]"
      rowLabelOffset="[[0, 10]]"
      numRows="2"
      wrap="false"
    />

    <!-- Estado Vazio (quando não há favoritos) -->
    <Group id="emptyState" translation="[80, 220]" visible="false">
      <Rectangle width="1760" height="300" color="#111827" />
      <Rectangle width="1760" height="3" color="#FFB454" />
      <Label translation="[40, 60]" width="1680" text="Nenhum favorito adicionado ainda" color="#FFFFFF" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="26" /></Label>
      <Label translation="[40, 120]" width="1680" text="Pressione o botão [*] ou [Replay] no controle remoto enquanto assiste a um canal ou na ficha de um filme/série para adicioná-lo aqui." color="#94a3b8" horizAlign="center" wrap="true"><Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="22" /></Label>
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/FavoritesScreen.brs" />
</component>
