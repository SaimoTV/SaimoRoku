      <Label id="aviso" translation="[0, 100]" width="1500" text="" color="#FFB454"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="22" /></Label>

      <Group id="painelLista" translation="[0, 150]">
