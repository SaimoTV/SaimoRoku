<?xml version="1.0" encoding="utf-8" ?>
<component name="RadiosScreen" extends="Group">
  <interface>
    <field id="radios" type="array" onChange="onRadiosChange" />
    <field id="focusUpRequested" type="boolean" alwaysNotify="true" />
    <function name="cleanUp" />
  </interface>

  <children>
    <Rectangle width="1920" height="1080" color="#0b0e14" />

    <!-- Lista de Rádios à Esquerda -->
    <Group translation="[80, 100]">
      <Rectangle width="560" height="920" color="#111827" />
      <Rectangle width="560" height="3" color="#FFB454" />
      <Label translation="[24, 20]" text="ESTAÇÕES DE RÁDIO" color="#FFB454"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>

      <LabelList
        id="radiosList"
        translation="[20, 60]"
        itemSize="[520, 54]"
        itemSpacing="[0, 6]"
        numRows="14"
        wrap="false"
        color="#94a3b8"
        focusedColor="#FFB454"
      />
    </Group>

    <!-- Painel de Tocando Agora à Direita -->
    <Group id="nowPlayingPanel" translation="[680, 100]">
      <Rectangle width="1160" height="920" color="#111827" />
      <Rectangle width="1160" height="3" color="#4FE3D0" />

      <!-- Ícone / Logo da Rádio Centralizado -->
      <Poster id="radioLogo" translation="[440, 140]" width="280" height="280" loadDisplayMode="scaleToFit" />

      <!-- Textos -->
      <Label id="radioName" translation="[0, 460]" width="1160" text="Selecione uma rádio para ouvir" color="#FFFFFF" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="38" /></Label>
      <Label id="radioGenre" translation="[0, 520]" width="1160" text="" color="#4FE3D0" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="26" /></Label>
      <Label id="radioStatus" translation="[0, 580]" width="1160" text="" color="#94a3b8" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="22" /></Label>
    </Group>

    <!-- Audio Player Nativo de Background -->
    <Audio id="radioAudio" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/screens/RadiosScreen.brs" />
</component>
