<?xml version="1.0" encoding="utf-8" ?>
<component name="RadiosScreen" extends="Group">
  <interface>
    <field id="radios" type="array" onChange="onRadiosChange" />
  </interface>

  <children>
    <Rectangle width="1920" height="1080" color="#0b0e14" />

    <!-- Topo -->
    <Group translation="[100, 40]">
      <Label text="Rádios Online" font="font:LargeBoldSystemFont" color="#FFFFFF" />
      <Label translation="[0, 45]" text="Estações AM/FM e Web Rádios de todo o Brasil" font="font:SmallSystemFont" color="#94a3b8" />
    </Group>

    <!-- Lista de Rádios -->
    <Group translation="[100, 140]">
      <Rectangle width="600" height="880" color="#111827" />
      <Rectangle width="600" height="3" color="#FFB454" />
      <Label translation="[24, 20]" text="ESTAÇÕES" font="font:SmallBoldSystemFont" color="#FFB454" />

      <LabelList
        id="radiosList"
        translation="[20, 60]"
        itemSize="[560, 56]"
        itemSpacing="[0, 6]"
        numRows="13"
      />
    </Group>

    <!-- Painel de Tocando Agora -->
    <Group id="nowPlayingPanel" translation="[740, 140]">
      <Rectangle width="1080" height="880" color="#111827" />
      <Rectangle width="1080" height="3" color="#4FE3D0" />

      <!-- Ícone / Logo da Rádio -->
      <Poster id="radioLogo" translation="[420, 160]" width="240" height="240" loadDisplayMode="scaleToFit" />

      <!-- Textos -->
      <Label id="radioName" translation="[0, 440]" width="1080" text="Selecione uma rádio para ouvir" font="font:LargeBoldSystemFont" color="#FFFFFF" horizAlign="center" />
      <Label id="radioGenre" translation="[0, 500]" width="1080" text="" font="font:MediumSystemFont" color="#4FE3D0" horizAlign="center" />

      <!-- Status -->
      <Label id="radioStatus" translation="[0, 560]" width="1080" text="" font="font:SmallSystemFont" color="#94a3b8" horizAlign="center" />
    </Group>

    <!-- Audio Player Nativo de Background -->
    <Audio id="radioAudio" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/screens/RadiosScreen.brs" />
</component>
