<?xml version="1.0" encoding="utf-8" ?>
<component name="FichaScreen" extends="Group">
  <interface>
    <field id="item" type="assocarray" onChange="onItemChange" />
    <field id="playRequested" type="assocarray" alwaysNotify="true" />
    <field id="focusUpRequested" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <!-- Backdrop Fundo -->
    <Poster id="backdropPoster" width="1920" height="1080" loadDisplayMode="scaleToZoom" />
    <Rectangle width="1920" height="1080" color="#0b0e14D8" />

    <!-- Container Principal de Detalhes -->
    <Group translation="[112, 130]">
      <!-- Poster Retrato -->
      <Poster id="posterNode" width="300" height="450" loadWidth="300" loadHeight="450" loadDisplayMode="scaleToZoom" />
      <Poster width="300" height="450" uri="pkg:/images/p_canto.9.png" />

      <!-- Informações Textuais -->
      <Group translation="[370, 0]">
        <Label id="titleLabel" width="1300" height="70" maxLines="1" text="" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="54" /></Label>
        <Label id="metaLabel" translation="[0, 76]" width="1200" text="" color="#D5DCE5"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="22" /></Label>
        <Label id="genresLabel" translation="[0, 116]" width="1200" text="" color="#94a3b8"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="22" /></Label>
        

        <!-- Botões de Ação Idênticos ao TV Box -->
        <Group id="actionsRow" translation="[0, 164]">
          <!-- 0: Botão Assistir -->
          <Group id="playBtnGroup" translation="[0, 0]">
            <Rectangle id="playBtnBorder" width="0" height="0" visible="false" />
            <Poster id="playBtnBg" width="300" height="84" uri="pkg:/images/p_btn.9.png" blendColor="#FFFFFF24" />
            <Label id="playBtnText" width="300" height="84" horizAlign="center" vertAlign="center" text="Assistir" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="30" /></Label>
          </Group>

          <!-- 1: Botão Continuar -->
          <Group id="resumeBtnGroup" translation="[316, 0]" visible="false">
            <Rectangle id="resumeBtnBorder" width="0" height="0" visible="false" />
            <Poster id="resumeBtnBg" width="300" height="84" uri="pkg:/images/p_btn.9.png" blendColor="#FFFFFF24" />
            <Label id="resumeBtnText" width="300" height="84" horizAlign="center" vertAlign="center" text="Continuar" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="30" /></Label>
          </Group>

          <!-- 2: Botão Versão (Dublado / Legendado) -->
          <Group id="versionBtnGroup" translation="[316, 0]">
            <Rectangle id="versionBtnBorder" width="0" height="0" visible="false" />
            <Poster id="versionBtnBg" width="300" height="84" uri="pkg:/images/p_btn.9.png" blendColor="#FFFFFF24" />
            <Label id="versionBtnText" width="300" height="84" horizAlign="center" vertAlign="center" text="Versão: Dublado" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="30" /></Label>
          </Group>

          <!-- 3: Botão Favoritar -->
          <Group id="favBtnGroup" translation="[632, 0]">
            <Rectangle id="favBtnBorder" width="0" height="0" visible="false" />
            <Poster id="favBtnBg" width="250" height="84" uri="pkg:/images/p_btn.9.png" blendColor="#FFFFFF24" />
            <Label id="favBtnText" width="250" height="84" horizAlign="center" vertAlign="center" text="Favoritar" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="30" /></Label>
          </Group>
        </Group>
      </Group>

      <Label id="overviewLabel" translation="[370, 272]" width="1300" height="170" maxLines="4" wrap="true" text="" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="30" /></Label>

      <!-- Painel de Séries: Seletor de Temporadas e Episódios -->
      <Group id="seriesPanel" translation="[0, 480]" visible="false">
        <!-- Seletor de Temporadas -->
        <Group id="seasonsBar" translation="[0, 0]">
          <Group id="seasonTab_1" translation="[0, 0]">
            <Rectangle id="seasonBorder_1" width="0" height="0" visible="false" />
            <Poster id="seasonBg_1" width="224" height="60" uri="pkg:/images/p_branca.9.png" blendColor="#FFFFFF24" />
            <Label id="seasonText_1" width="224" height="60" horizAlign="center" vertAlign="center" text="Temporada 1" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="28" /></Label>
          </Group>
          <Group id="seasonTab_2" translation="[240, 0]">
            <Rectangle id="seasonBorder_2" width="0" height="0" visible="false" />
            <Poster id="seasonBg_2" width="224" height="60" uri="pkg:/images/p_branca.9.png" blendColor="#FFFFFF24" />
            <Label id="seasonText_2" width="224" height="60" horizAlign="center" vertAlign="center" text="Temporada 2" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="28" /></Label>
          </Group>
          <Group id="seasonTab_3" translation="[480, 0]">
            <Rectangle id="seasonBorder_3" width="0" height="0" visible="false" />
            <Poster id="seasonBg_3" width="224" height="60" uri="pkg:/images/p_branca.9.png" blendColor="#FFFFFF24" />
            <Label id="seasonText_3" width="224" height="60" horizAlign="center" vertAlign="center" text="Temporada 3" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="28" /></Label>
          </Group>
        </Group>

        <!-- Grade de Episódios -->
        <RowList
          id="episodesRowList"
          itemComponentName="EpisodeItem"
          translation="[0, 80]"
          itemSize="[1760, 220]"
          rowItemSize="[[280, 200]]"
          rowItemSpacing="[[24, 0]]"
          rowHeights="[220]"
          rowLabelOffset="[[0, 0]]"
          showRowLabel="[false]"
          numRows="1"
        />
      </Group>
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/FichaScreen.brs" />
</component>
