<?xml version="1.0" encoding="utf-8" ?>
<component name="FichaScreen" extends="Group">
  <interface>
    <field id="item" type="assocarray" onChange="onItemChange" />
    <field id="playRequested" type="assocarray" />
  </interface>

  <children>
    <!-- Backdrop Fundo -->
    <Poster id="backdropPoster" width="1920" height="1080" loadDisplayMode="scaleToZoom" />
    <Rectangle width="1920" height="1080" color="#0b0e14E6" />

    <!-- Container Principal de Detalhes -->
    <Group translation="[100, 80]">
      <!-- Poster Retrato -->
      <Poster id="posterNode" width="280" height="420" loadDisplayMode="scaleToFit" />

      <!-- Informações Textuais -->
      <Group translation="[320, 0]">
        <Label id="titleLabel" width="1200" text="Título" font="font:LargeBoldSystemFont" color="#FFFFFF" />
        <Label id="metaLabel" translation="[0, 55]" width="1000" text="2026 • Full HD • ★ 8.5" font="font:SmallSystemFont" color="#4FE3D0" />
        <Label id="genresLabel" translation="[0, 90]" width="1000" text="Ação, Aventura, Ficção" font="font:SmallSystemFont" color="#94a3b8" />
        <Label id="overviewLabel" translation="[0, 130]" width="1100" numLines="4" text="Sinopse detalhada do filme ou série..." font="font:SmallSystemFont" color="#cbd5e1" wrap="true" />

        <!-- Botões de Ação -->
        <Group id="actionsRow" translation="[0, 270]">
          <!-- Botão Assistir -->
          <Group id="playBtnGroup">
            <Rectangle id="playBtnBg" width="240" height="54" color="#4FE3D0" />
            <Poster translation="[24, 14]" width="26" height="26" uri="pkg:/images/icons/icon_live.png" blendColor="#0b0e14" />
            <Label id="playBtnText" translation="[60, 14]" width="160" text="Assistir Agora" font="font:MediumBoldSystemFont" color="#0b0e14" />
          </Group>

          <!-- Botão Continuar -->
          <Group id="resumeBtnGroup" translation="[260, 0]" visible="false">
            <Rectangle id="resumeBtnBg" width="260" height="54" color="#1e293b" />
            <Label id="resumeBtnText" translation="[0, 14]" width="260" text="Continuar" font="font:MediumBoldSystemFont" color="#FFFFFF" horizAlign="center" />
          </Group>
        </Group>
      </Group>

      <!-- Painel de Séries: Temporadas e Episódios -->
      <Group id="seriesPanel" translation="[0, 480]" visible="false">
        <Label translation="[0, 0]" text="Episódios Disponíveis" font="font:MediumBoldSystemFont" color="#FFFFFF" />
        <RowList
          id="episodesRowList"
          itemComponentName="PosterItem"
          translation="[0, 40]"
          itemSize="[1720, 290]"
          rowItemSize="[[160, 280]]"
          rowItemSpacing="[[20, 0]]"
          showRowLabel="[false]"
          numRows="1"
        />
      </Group>
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/FichaScreen.brs" />
</component>
