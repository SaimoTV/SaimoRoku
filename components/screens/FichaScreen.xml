<?xml version="1.0" encoding="utf-8" ?>
<component name="FichaScreen" extends="Group">
  <interface>
    <field id="item" type="assocarray" onChange="onItemChange" />
    <field id="playRequested" type="assocarray" alwaysNotify="true" />
    <field id="focusUpRequested" type="boolean" alwaysNotify="true" />
    <function name="cleanUp" />
  </interface>

  <children>
    <!-- Backdrop Fundo -->
    <Poster id="backdropPoster" width="1920" height="1080" loadDisplayMode="scaleToZoom" />
    <Rectangle width="1920" height="1080" color="#0b0e14D8" />

    <!-- Container Principal de Detalhes -->
    <Group translation="[112, 130]">
      <!-- Poster Retrato -->
      <Poster id="posterNode" width="300" height="450" loadWidth="300" loadHeight="450" loadDisplayMode="scaleToZoom" />
      <Poster width="300" height="450" uri="pkg:/images/p_canto.9.png" />

      <!-- Informações Textuais -->
      <Group translation="[370, 0]">
        <Label id="titleLabel" width="1300" height="70" maxLines="1" text="" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="54" /></Label>
        <Label id="metaLabel" translation="[0, 76]" width="1200" text="" color="#D5DCE5"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="22" /></Label>
        <Label id="genresLabel" translation="[0, 116]" width="1200" text="" color="#94a3b8"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="22" /></Label>
        

        <!-- Botões de Ação Idênticos ao TV Box + Fontes de Addons -->
        <Group id="actionsRow" translation="[0, 164]">
          <!-- 0: Botão Assistir -->
          <Group id="playBtnGroup" translation="[0, 0]">
            <Rectangle id="playBtnBorder" width="0" height="0" visible="false" />
            <Poster id="playBtnBg" width="230" height="84" uri="pkg:/images/p_btn.9.png" blendColor="#FFFFFF24" />
            <Label id="playBtnText" width="230" height="84" horizAlign="center" vertAlign="center" text="Assistir" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="28" /></Label>
          </Group>

          <!-- 1: Botão Continuar -->
          <Group id="resumeBtnGroup" translation="[246, 0]" visible="false">
            <Rectangle id="resumeBtnBorder" width="0" height="0" visible="false" />
            <Poster id="resumeBtnBg" width="290" height="84" uri="pkg:/images/p_btn.9.png" blendColor="#FFFFFF24" />
            <Label id="resumeBtnText" width="290" height="84" horizAlign="center" vertAlign="center" text="Continuar" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="26" /></Label>
          </Group>

          <!-- 2: Botão Versão (Dublado / Legendado) -->
          <Group id="versionBtnGroup" translation="[246, 0]">
            <Rectangle id="versionBtnBorder" width="0" height="0" visible="false" />
            <Poster id="versionBtnBg" width="290" height="84" uri="pkg:/images/p_btn.9.png" blendColor="#FFFFFF24" />
            <Label id="versionBtnText" width="290" height="84" horizAlign="center" vertAlign="center" text="Versão: Dublado" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="26" /></Label>
          </Group>

          <!-- 3: Botão Fontes -->
          <Group id="sourcesBtnGroup" translation="[552, 0]">
            <Rectangle id="sourcesBtnBorder" width="0" height="0" visible="false" />
            <Poster id="sourcesBtnBg" width="220" height="84" uri="pkg:/images/p_btn.9.png" blendColor="#FFFFFF24" />
            <Label id="sourcesBtnText" width="220" height="84" horizAlign="center" vertAlign="center" text="Fontes" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="28" /></Label>
          </Group>

          <!-- 4: Botão Favoritar -->
          <Group id="favBtnGroup" translation="[788, 0]">
            <Rectangle id="favBtnBorder" width="0" height="0" visible="false" />
            <Poster id="favBtnBg" width="240" height="84" uri="pkg:/images/p_btn.9.png" blendColor="#FFFFFF24" />
            <Label id="favBtnText" width="240" height="84" horizAlign="center" vertAlign="center" text="Favoritar" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="28" /></Label>
          </Group>
        </Group>
      </Group>

      <Label id="overviewLabel" translation="[370, 272]" width="1300" height="170" maxLines="4" wrap="true" text="" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="30" /></Label>

      <!-- Painel de Séries: Seletor de Temporadas Dinâmico e Episódios -->
      <Group id="seriesPanel" translation="[0, 480]" visible="false">
        <RowList
          id="seasonsRowList"
          itemComponentName="SeasonTabItem"
          translation="[0, 0]"
          itemSize="[1696, 68]"
          rowItemSize="[[224, 60]]"
          rowItemSpacing="[[16, 0]]"
          rowHeights="[68]"
          rowLabelOffset="[[0, 0]]"
          showRowLabel="[false]"
          rowFocusAnimationStyle="floatingFocus"
          vertFocusAnimationStyle="fixedFocus"
          drawFocusFeedback="false"
          numRows="1"
        />

        <!-- Grade de Episódios -->
        <RowList
          id="episodesRowList"
          itemComponentName="EpisodeItem"
          translation="[0, 80]"
          itemSize="[1760, 220]"
          rowItemSize="[[280, 200]]"
          rowItemSpacing="[[24, 0]]"
          rowHeights="[220]"
          rowLabelOffset="[[0, 0]]"
          showRowLabel="[false]"
          rowFocusAnimationStyle="floatingFocus"
          vertFocusAnimationStyle="fixedFocus"
          drawFocusFeedback="false"
          numRows="1"
        />
      </Group>
    </Group>

    <PainelLateral id="painelFontes" />

    <!-- Diálogo de aviso Debrid -->
    <Group id="debridDialog" translation="[560, 360]" visible="false">
      <Rectangle width="800" height="340" color="#0b0e14FA" />
      <Rectangle width="800" height="4" color="#4FE3D0" />
      <Label id="debridDialogTitle" translation="[40, 36]" width="720" text="Requer conta Debrid para Torrent" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="34" /></Label>
      <Label id="debridDialogMsg" translation="[40, 96]" width="720" height="150" wrap="true" maxLines="4" lineSpacing="6" text="Configure TorBox, Real-Debrid, AllDebrid ou Premiumize em Ajustes &gt; Addons e Debrid (ou pelo QR Code em /addons) para reproduzir torrents." color="#A8B4C0"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="26" /></Label>
      <Label translation="[40, 276]" width="720" text="Pressione OK ou Voltar para fechar" color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="24" /></Label>
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/Addons.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/Debrid.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/FichaScreen.brs" />
</component>
