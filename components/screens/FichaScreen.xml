<?xml version="1.0" encoding="utf-8" ?>
<component name="FichaScreen" extends="Group">
  <interface>
    <field id="item" type="assocarray" onChange="onItemChange" />
    <field id="playRequested" type="assocarray" alwaysNotify="true" />
    <field id="focusUpRequested" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <!-- Backdrop Fundo -->
    <Poster id="backdropPoster" width="1920" height="1080" loadDisplayMode="scaleToZoom" />
    <Rectangle width="1920" height="1080" color="#0b0e14E6" />

    <!-- Container Principal de Detalhes -->
    <Group translation="[80, 80]">
      <!-- Poster Retrato -->
      <Poster id="posterNode" width="280" height="420" loadDisplayMode="scaleToFit" />

      <!-- Informações Textuais -->
      <Group translation="[320, 0]">
        <Label id="titleLabel" width="1200" text="Título" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="38" /></Label>
        <Label id="metaLabel" translation="[0, 55]" width="1000" text="2026 • Full HD" color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="22" /></Label>
        <Label id="genresLabel" translation="[0, 90]" width="1000" text="Ação, Aventura, Ficção" color="#94a3b8"><Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="22" /></Label>
        <Label id="overviewLabel" translation="[0, 130]" width="1140" numLines="4" text="Sinopse detalhada do filme ou série..." color="#cbd5e1" wrap="true"><Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="22" /></Label>

        <!-- Botões de Ação Idênticos ao TV Box -->
        <Group id="actionsRow" translation="[0, 270]">
          <!-- 0: Botão Assistir -->
          <Group id="playBtnGroup" translation="[0, 0]">
            <Rectangle id="playBtnBorder" translation="[-3, -3]" width="226" height="56" color="#FFFFFF" visible="false" />
            <Rectangle id="playBtnBg" width="220" height="50" color="#4FE3D0" />
            <Label id="playBtnText" translation="[0, 12]" width="220" text="▶  Assistir" color="#0b0e14" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="26" /></Label>
          </Group>

          <!-- 1: Botão Continuar -->
          <Group id="resumeBtnGroup" translation="[240, 0]" visible="false">
            <Rectangle id="resumeBtnBorder" translation="[-3, -3]" width="226" height="56" color="#FFFFFF" visible="false" />
            <Rectangle id="resumeBtnBg" width="220" height="50" color="#1e293b" />
            <Label id="resumeBtnText" translation="[0, 12]" width="220" text="Continuar" color="#FFFFFF" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="26" /></Label>
          </Group>

          <!-- 2: Botão Versão (Dublado / Legendado) -->
          <Group id="versionBtnGroup" translation="[480, 0]">
            <Rectangle id="versionBtnBorder" translation="[-3, -3]" width="226" height="56" color="#FFFFFF" visible="false" />
            <Rectangle id="versionBtnBg" width="220" height="50" color="#1e293b" />
            <Label id="versionBtnText" translation="[0, 12]" width="220" text="Versão: Dublado" color="#FFFFFF" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
          </Group>

          <!-- 3: Botão Favoritar -->
          <Group id="favBtnGroup" translation="[720, 0]">
            <Rectangle id="favBtnBorder" translation="[-3, -3]" width="226" height="56" color="#FFFFFF" visible="false" />
            <Rectangle id="favBtnBg" width="220" height="50" color="#1e293b" />
            <Label id="favBtnText" translation="[0, 12]" width="220" text="Favoritar" color="#FFFFFF" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
          </Group>
        </Group>
      </Group>

      <!-- Painel de Séries: Seletor de Temporadas e Episódios -->
      <Group id="seriesPanel" translation="[0, 450]" visible="false">
        <!-- Seletor de Temporadas -->
        <Group id="seasonsBar" translation="[0, 0]">
          <Group id="seasonTab_1" translation="[0, 0]">
            <Rectangle id="seasonBorder_1" translation="[-2, -2]" width="154" height="40" color="#FFFFFF" visible="false" />
            <Rectangle id="seasonBg_1" width="150" height="36" color="#4FE3D0" />
            <Label id="seasonText_1" translation="[0, 8]" width="150" text="Temporada 1" color="#0b0e14" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
          </Group>
          <Group id="seasonTab_2" translation="[165, 0]">
            <Rectangle id="seasonBorder_2" translation="[-2, -2]" width="154" height="40" color="#FFFFFF" visible="false" />
            <Rectangle id="seasonBg_2" width="150" height="36" color="#1e293b" />
            <Label id="seasonText_2" translation="[0, 8]" width="150" text="Temporada 2" color="#94a3b8" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
          </Group>
          <Group id="seasonTab_3" translation="[330, 0]">
            <Rectangle id="seasonBorder_3" translation="[-2, -2]" width="154" height="40" color="#FFFFFF" visible="false" />
            <Rectangle id="seasonBg_3" width="150" height="36" color="#1e293b" />
            <Label id="seasonText_3" translation="[0, 8]" width="150" text="Temporada 3" color="#94a3b8" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
          </Group>
        </Group>

        <!-- Grade de Episódios -->
        <RowList
          id="episodesRowList"
          itemComponentName="EpisodeItem"
          translation="[0, 50]"
          itemSize="[1760, 220]"
          rowItemSize="[[280, 200]]"
          rowItemSpacing="[[24, 0]]"
          rowHeights="[220]"
          rowLabelOffset="[[0, 0]]"
          showRowLabel="[false]"
          numRows="1"
        />
      </Group>
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/FichaScreen.brs" />
</component>
