<?xml version="1.0" encoding="utf-8" ?>
<component name="SettingsScreen" extends="Group">
  <interface>
    <field id="reloadRequested" type="boolean" value="false" />
  </interface>

  <children>
    <Rectangle width="1920" height="1080" color="#0b0e14" />

    <!-- Topo -->
    <Group translation="[100, 40]">
      <Label text="Ajustes e Preferências" font="font:LargeBoldSystemFont" color="#FFFFFF" />
      <Label translation="[0, 45]" text="Configure a reprodução, áudio inteligente, rede e controle parental" font="font:SmallSystemFont" color="#94a3b8" />
    </Group>

    <!-- Lista de Opções de Configuração -->
    <Group translation="[100, 140]">
      <Rectangle width="1100" height="880" color="#111827" />
      <Rectangle width="1100" height="3" color="#4FE3D0" />

      <LabelList
        id="settingsList"
        translation="[20, 30]"
        itemSize="[1060, 64]"
        itemSpacing="[0, 8]"
        numRows="12"
        color="#94a3b8"
        focusedColor="#4FE3D0"
      />
    </Group>

    <!-- Painel Lateral: Info do Sistema e Saimo Connect -->
    <Group translation="[1240, 140]">
      <Rectangle width="580" height="880" color="#111827" />
      <Rectangle width="580" height="3" color="#7AA2FF" />
      <Label translation="[30, 24]" text="INFORMAÇÕES DO SISTEMA" font="font:SmallBoldSystemFont" color="#7AA2FF" />

      <!-- Card Saimo Connect -->
      <Group translation="[30, 80]">
        <Rectangle width="520" height="150" color="#1e293b" />
        <Label translation="[20, 16]" text="Saimo Connect" font="font:MediumBoldSystemFont" color="#4FE3D0" />
        <Label translation="[20, 52]" text="Controle pelo celular na mesma rede Wi-Fi" font="font:SmallSystemFont" color="#94a3b8" />
        <Label id="connectStatusLabel" translation="[20, 84]" text="Porta: 8999 • Status: Ativo" font="font:SmallBoldSystemFont" color="#FFFFFF" />
        <Label translation="[20, 114]" text="Descoberta automática via GET /info" font="font:SmallSystemFont" color="#64748b" />
      </Group>

      <!-- Card Versão -->
      <Group translation="[30, 260]">
        <Rectangle width="520" height="130" color="#1e293b" />
        <Label translation="[20, 16]" text="Versão Instalada" font="font:MediumBoldSystemFont" color="#FFFFFF" />
        <Label translation="[20, 52]" text="Saimo TV para Roku" font="font:SmallSystemFont" color="#94a3b8" />
        <Label translation="[20, 84]" text="Versão 2.6.0 (Build Nativo)" font="font:MediumBoldSystemFont" color="#4FE3D0" />
      </Group>

      <Label translation="[30, 420]" width="520" numLines="4" text="Aplicativo nativo desenvolvido em BrightScript e SceneGraph para alta fluidez e resposta instantânea no controle remoto." font="font:SmallSystemFont" color="#475569" wrap="true" />
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/SettingsScreen.brs" />
</component>
