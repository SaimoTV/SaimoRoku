<?xml version="1.0" encoding="utf-8" ?>
<component name="SearchScreen" extends="Group">
  <interface>
    <field id="channels" type="array" />
    <field id="vodItems" type="array" />
    <field id="itemSelected" type="assocarray" alwaysNotify="true" />
    <field id="tuneRequested" type="assocarray" alwaysNotify="true" />
    <field id="focusUpRequested" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <Rectangle width="1920" height="1080" color="#0b0e14" />

    <!-- Teclado Roku Nativo à Esquerda (MiniKeyboard com largura total de 576px) -->
    <Group translation="[80, 110]">
      <Label text="DIGITE PARA BUSCAR" color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
      <MiniKeyboard id="searchKeyboard" translation="[0, 36]" />
    </Group>

    <!-- Resultados à Direita -->
    <Group translation="[720, 110]">
      <Rectangle width="1120" height="920" color="#111827" />
      <Rectangle width="1120" height="3" color="#4FE3D0" />
      <Label id="resultsHeader" translation="[30, 20]" text="RESULTADOS" color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>

      <LabelList
        id="resultsList"
        translation="[20, 60]"
        itemSize="[1080, 56]"
        itemSpacing="[0, 6]"
        numRows="14"
        color="#94a3b8"
        focusedColor="#4FE3D0"
      />
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/components/screens/SearchScreen.brs" />
</component>
