<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScreen" extends="Group">
  <interface>
    <field id="playItem" type="assocarray" onChange="onPlayItemChange" />
    <field id="exitRequested" type="boolean" value="false" />
    <function name="cleanUp" />
    <function name="playPause" />
    <function name="abrirOpcoes" />
    <function name="seek" />
  </interface>

  <children>
    <!-- Player de Vídeo Nativo por Hardware -->
    <Video id="videoPlayer" width="1920" height="1080" translation="[0, 0]" enableUI="false" focusable="false" />

    <!-- Indicador de Buffer / Carregamento -->
    <Group id="bufferingGroup" translation="[760, 500]" visible="false">
      <Rectangle translation="[-40, -20]" width="480" height="80" color="#000000D8" />
      <Label id="loadingLabel" width="400" horizAlign="center" text="Carregando vídeo..." color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="26" /></Label>
    </Group>

    <!-- Indicador de Erro -->
    <Group id="errorGroup" translation="[660, 460]" visible="false">
      <Rectangle translation="[-30, -20]" width="660" height="140" color="#0b0e14F4" />
      <Rectangle translation="[-30, -20]" width="660" height="3" color="#e11d48" />
      <Label id="errorLabel" translation="[0, 10]" width="600" wrap="true" maxLines="2" text="Vídeo indisponível no momento" color="#FFFFFF" horizAlign="center"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="26" /></Label>
      <Label translation="[0, 82]" width="600" text="Pressione [Voltar] no controle remoto" color="#94a3b8" horizAlign="center"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="22" /></Label>
    </Group>

    <!-- Aviso Debrid necessário para Torrent -->
    <Group id="debridDialog" translation="[560, 360]" visible="false">
      <Rectangle width="800" height="340" color="#0b0e14FA" />
      <Rectangle width="800" height="4" color="#4FE3D0" />
      <Label id="debridDialogTitle" translation="[40, 36]" width="720" text="Requer conta Debrid para Torrent" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="34" /></Label>
      <Label id="debridDialogMsg" translation="[40, 96]" width="720" height="150" wrap="true" maxLines="4" lineSpacing="6" text="Este stream é um torrent (infoHash). Configure TorBox, Real-Debrid, AllDebrid ou Premiumize em Ajustes &gt; Addons e Debrid (ou via QR Code) para reproduzir torrents no Roku." color="#A8B4C0"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="26" /></Label>
      <Label translation="[40, 276]" width="720" text="Pressione OK ou Voltar para fechar" color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="24" /></Label>
    </Group>

    <!-- OSD Customizado Completo -->
    <PlayerOSD id="playerOsd" />

    <!-- Timer de salvamento de progresso a cada 5 segundos -->
    <Timer id="progressTimer" duration="5.0" repeat="true" />
    <PainelLateral id="painelOpcoes" />
  </children>

  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/Format.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/Addons.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/Debrid.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/PlayerScreen.brs" />
</component>
