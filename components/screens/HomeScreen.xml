<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScreen" extends="Group">
  <interface>
    <field id="featuredItem" type="assocarray" onChange="onFeaturedChange" />
    <field id="railsData" type="array" onChange="onRailsChange" />
    <field id="channels" type="array" onChange="onRailsChange" />
    <field id="epgMap" type="assocarray" />
    <field id="vodItems" type="array" />
    <field id="itemSelected" type="assocarray" alwaysNotify="true" />
        <field id="tuneRequested" type="assocarray" alwaysNotify="true" />
    <field id="focusUpRequested" type="boolean" alwaysNotify="true" />
    <field id="minhasListasRequested" type="boolean" alwaysNotify="true" />
    <function name="cleanUp" />
  </interface>

  <children>
    <!-- Banner de Destaque Dinâmico (Backdrop + Info) -->
    <HeroBanner id="heroBanner" translation="[0, 0]" />

    <!-- Trilhos Horizontais de Conteúdo Estilo TV Box -->
    <RowList
      id="contentRowList"
      itemComponentName="PosterItem"
      translation="[100, 430]"
      itemSize="[1820, 480]"
      rowHeights="[480]"
      rowItemSize="[[272, 460]]"
      rowItemSpacing="[[32, 0]]"
      itemSpacing="[0, 28]"
      showRowLabel="[true]"
      rowLabelOffset="[[12, 18]]"
      rowLabelColor="#FFFFFF"
      rowFocusAnimationStyle="floatingFocus"
      vertFocusAnimationStyle="fixedFocus"
      drawFocusFeedback="false"
      numRows="2"
      wrap="false"
    ><Font role="rowLabelFont" uri="pkg:/fonts/Roboto-Medium.ttf" size="36" /></RowList>
    <!-- Sem lista nenhuma: boas-vindas e o caminho para adicionar uma -->
    <Label id="boasVindas" visible="false" translation="[100, 420]" width="1600" wrap="true" lineSpacing="6" text="Bem-vindo ao Saimo! Para começar, adicione uma lista M3U (só o link já basta) ou uma lista com usuário e senha." color="#A8B4C0"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="34" /></Label>
    <LabelList id="botaoLista" visible="false" translation="[100, 560]" itemSize="[760, 72]" numRows="1" wrap="false" color="#D5DCE5" focusedColor="#0b0e14" focusBitmapBlendColor="#4FE3D0"><Font role="font" uri="pkg:/fonts/Roboto-Regular.ttf" size="30" /><Font role="focusedFont" uri="pkg:/fonts/Roboto-Medium.ttf" size="30" /></LabelList>
    <Timer id="heroTimer" duration="0.3" repeat="false" />
    <Timer id="montarTimer" duration="0.15" repeat="false" />
  </children>

  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/source/utils/Rows.brs" />
  <script type="text/brightscript" uri="pkg:/components/screens/HomeScreen.brs" />
</component>
