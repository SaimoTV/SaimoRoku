<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScreen" extends="Group">
  <interface>
    <field id="featuredItem" type="assocarray" onChange="onFeaturedChange" />
    <field id="railsData" type="array" onChange="onRailsChange" />
    <field id="itemSelected" type="assocarray" />
    <field id="playRequested" type="assocarray" />
  </interface>

  <children>
    <!-- Banner de Destaque -->
    <HeroBanner id="heroBanner" translation="[80, 0]" />

    <!-- Trilhos Horizontais de Conteúdo (RowList) -->
    <RowList
      id="contentRowList"
      itemComponentName="PosterItem"
      translation="[80, 480]"
      itemSize="[1760, 290]"
      rowItemSize="[[160, 280]]"
      rowItemSpacing="[[20, 0]]"
      itemSpacing="[0, 30]"
      showRowLabel="[true]"
      rowLabelOffset="[[0, 10]]"
      numRows="3"
    />
  </children>

  <script type="text/brightscript" uri="pkg:/components/screens/HomeScreen.brs" />
</component>
