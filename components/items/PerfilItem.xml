<?xml version="1.0" encoding="utf-8" ?>
<!-- Um perfil (ou um avatar) na grade de perfis: imagem, nome e o selo KIDS. -->
<component name="PerfilItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onItemContentChange" />
    <field id="width" type="float" />
    <field id="height" type="float" />
    <field id="focusPercent" type="float" onChange="onFocusChange" />
    <field id="gridHasFocus" type="boolean" onChange="onFocusChange" />
  </interface>
  <children>
    <Rectangle id="moldura" translation="[0, 0]" width="200" height="200" color="#FFFFFF" visible="false" />
    <Poster id="avatar" translation="[8, 8]" width="184" height="184" loadWidth="184" loadHeight="184" />
    <Label id="mais" translation="[8, 8]" width="184" height="184" horizAlign="center" vertAlign="center" color="#FFFFFFCC" text="+"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="96" /></Label>
    <Group id="selo" translation="[118, 160]" visible="false">
      <Rectangle width="76" height="30" color="#FFB43D" />
      <Label width="76" height="30" horizAlign="center" vertAlign="center" color="#2A1400" text="KIDS"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="20" /></Label>
    </Group>
    <Label id="nome" translation="[-20, 212]" width="240" horizAlign="center" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Roboto-Medium.ttf" size="28" /></Label>
  </children>
  <script type="text/brightscript" uri="pkg:/components/items/PerfilItem.brs" />
</component>
