<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onItemContentChange" />
    <field id="width" type="float" value="160" />
    <field id="height" type="float" value="280" />
  </interface>

  <children>
    <Poster id="poster" width="160" height="230" loadDisplayMode="scaleToZoom" />
    <Label id="title" translation="[0, 235]" width="160" font="font:SmallSystemFont" color="#cbd5e1" maxLines="2" wrap="true" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/items/PosterItem.brs" />
</component>
