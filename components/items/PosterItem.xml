<?xml version="1.0" encoding="utf-8" ?>
<component name="PosterItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onItemContentChange" />
    <field id="width" type="float" value="200" />
    <field id="height" type="float" value="356" />
    <field id="focusPercent" type="float" onChange="onFocusChange" />
    <field id="rowListHasFocus" type="boolean" onChange="onFocusChange" />
  </interface>

  <children>
    <Rectangle id="focusBorder" translation="[-5, -5]" width="210" height="310" color="#4FE3D0" visible="false" />
    <Rectangle id="cardBg" width="200" height="300" color="#161f30" />
    <Poster id="poster" width="200" height="300" loadWidth="200" loadHeight="300" loadDisplayMode="scaleToZoom" />
    <Rectangle id="progressTrack" translation="[0, 294]" width="200" height="6" color="#334155" visible="false" />
    <Rectangle id="progressBar" translation="[0, 294]" width="0" height="6" color="#4FE3D0" visible="false" />
    <Label id="title" translation="[0, 310]" width="200" height="50" numLines="2" wrap="true" color="#A8B4C0"><Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="20" /></Label>
  </children>

  <script type="text/brightscript" uri="pkg:/components/items/PosterItem.brs" />
</component>
