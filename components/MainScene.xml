<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <interface>
    <field id="deepLink" type="assocarray" onChange="onDeepLinkChange" />
    <field id="sairDoApp" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <!-- Fundo base da aplicação -->
    <Poster id="sceneBg" width="1920" height="1080" loadWidth="1280" loadHeight="720" uri="pkg:/images/fundo.jpg" />

    <!-- Container de Telas Ativas -->
    <Group id="screensContainer" />

    <!-- Barra de Navegação Global Superior (Estilo TV Box) -->
    <TopNavBar id="topNavBar" />

    <!-- Tarefa de Carregamento de Dados em Background -->
    <DataLoaderTask id="dataLoader" />

    <!-- Servidor Saimo Connect (Porta 8999) -->
    <ConnectTask id="connectServer" />
  </children>

  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
</component>
