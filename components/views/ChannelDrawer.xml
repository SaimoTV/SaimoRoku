<?xml version="1.0" encoding="utf-8" ?>
<component name="ChannelDrawer" extends="Group">
  <interface>
    <field id="channels" type="array" onChange="onChannelsChange" />
    <field id="selectedIndex" type="integer" value="0" />
    <field id="channelSelected" type="assocarray" />
    <field id="isOpen" type="boolean" value="false" onChange="onOpenChange" />
  </interface>

  <children>
    <Group id="drawerContainer" translation="[-520, 0]" visible="false">
      <!-- Fundo do drawer -->
      <Rectangle width="500" height="1080" color="#0b0e14FA" />
      <Rectangle translation="[499, 0]" width="2" height="1080" color="#4FE3D0" />

      <!-- Cabeçalho -->
      <Label translation="[24, 20]" text="Canais Ao Vivo" font="font:LargeBoldSystemFont" color="#FFFFFF" />
      <Label id="countLabel" translation="[24, 62]" text="0 canais disponíveis" font="font:SmallSystemFont" color="#4FE3D0" />

      <!-- Barra de Busca (Acesso Rápido) -->
      <Group id="searchBarGroup" translation="[20, 92]">
        <Rectangle id="searchBarBorder" translation="[-2, -2]" width="464" height="40" color="#4FE3D0" visible="false" />
        <Rectangle id="searchBarBg" width="460" height="36" color="#1e293b" />
        <Label id="searchBarLabel" translation="[14, 8]" width="432" text="Buscar canal... (OK para digitar)" font="font:SmallSystemFont" color="#94a3b8" />
      </Group>

      <!-- Chips de Categorias dos Canais -->
      <Group id="categoryChipsGroup" translation="[20, 136]">
        <!-- Chip 0: Todos -->
        <Group id="chipGroup_0" translation="[0, 0]">
          <Rectangle id="chipBorder_0" translation="[-2, -2]" width="84" height="34" color="#FFFFFF" visible="true" />
          <Rectangle id="chipBg_0" width="80" height="30" color="#4FE3D0" />
          <Label id="chipText_0" translation="[0, 6]" width="80" text="Todos" font="font:SmallBoldSystemFont" color="#0b0e14" horizAlign="center" />
        </Group>

        <!-- Chip 1: Favoritos -->
        <Group id="chipGroup_1" translation="[86, 0]">
          <Rectangle id="chipBorder_1" translation="[-2, -2]" width="99" height="34" color="#FFFFFF" visible="false" />
          <Rectangle id="chipBg_1" width="95" height="30" color="#1e293b" />
          <Label id="chipText_1" translation="[0, 6]" width="95" text="Favoritos" font="font:SmallBoldSystemFont" color="#94a3b8" horizAlign="center" />
        </Group>

        <!-- Chip 2: Aberta -->
        <Group id="chipGroup_2" translation="[187, 0]">
          <Rectangle id="chipBorder_2" translation="[-2, -2]" width="89" height="34" color="#FFFFFF" visible="false" />
          <Rectangle id="chipBg_2" width="85" height="30" color="#1e293b" />
          <Label id="chipText_2" translation="[0, 6]" width="85" text="Aberta" font="font:SmallBoldSystemFont" color="#94a3b8" horizAlign="center" />
        </Group>

        <!-- Chip 3: Esportes -->
        <Group id="chipGroup_3" translation="[278, 0]">
          <Rectangle id="chipBorder_3" translation="[-2, -2]" width="94" height="34" color="#FFFFFF" visible="false" />
          <Rectangle id="chipBg_3" width="90" height="30" color="#1e293b" />
          <Label id="chipText_3" translation="[0, 6]" width="90" text="Esportes" font="font:SmallBoldSystemFont" color="#94a3b8" horizAlign="center" />
        </Group>

        <!-- Chip 4: Filmes -->
        <Group id="chipGroup_4" translation="[374, 0]">
          <Rectangle id="chipBorder_4" translation="[-2, -2]" width="90" height="34" color="#FFFFFF" visible="false" />
          <Rectangle id="chipBg_4" width="86" height="30" color="#1e293b" />
          <Label id="chipText_4" translation="[0, 6]" width="86" text="Filmes" font="font:SmallBoldSystemFont" color="#94a3b8" horizAlign="center" />
        </Group>
      </Group>

      <!-- Mini Teclado de Busca Embutido -->
      <Group id="keyboardContainer" translation="[20, 136]" visible="false">
        <MiniKeyboard id="searchKeyboard" />
      </Group>

      <!-- Lista de Canais -->
      <LabelList
        id="channelList"
        translation="[20, 178]"
        itemSize="[460, 52]"
        itemSpacing="[0, 4]"
        numRows="14"
        wrap="false"
        color="#94a3b8"
        focusedColor="#4FE3D0"
      />

      <!-- Rodapé de Ajuda -->
      <Rectangle translation="[20, 1024]" width="460" height="40" color="#111827" />
      <Label translation="[28, 1034]" text="[OK] Assistir  |  [Replay] Favoritar  |  [Cima] Filtros" font="font:SmallSystemFont" color="#94a3b8" />
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/source/utils/Storage.brs" />
  <script type="text/brightscript" uri="pkg:/components/views/ChannelDrawer.brs" />
</component>
