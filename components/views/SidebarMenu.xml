<?xml version="1.0" encoding="utf-8" ?>
<component name="SidebarMenu" extends="Group">
  <interface>
    <field id="isExpanded" type="boolean" value="false" onChange="onExpandedChange" />
    <field id="selectedIndex" type="integer" value="0" onChange="onIndexChange" />
    <field id="itemSelected" type="string" />
  </interface>

  <children>
    <!-- Fundo da barra lateral -->
    <Rectangle id="menuBg" width="80" height="1080" color="#0b0e14F0" />
    <Rectangle id="menuDivider" translation="[79, 0]" width="1" height="1080" color="#242c3d" />

    <!-- Logo no topo -->
    <Poster id="menuLogo" translation="[18, 30]" width="44" height="44" uri="pkg:/images/icon_hd.png" />
    <Label id="menuLogoText" translation="[75, 40]" text="SAIMO TV" font="font:MediumBoldSystemFont" color="#4FE3D0" visible="false" />

    <!-- Indicador de foco ativo -->
    <Rectangle id="focusPill" translation="[8, 120]" width="64" height="52" color="#1a2233" />
    <Rectangle id="focusBar" translation="[8, 120]" width="4" height="52" color="#4FE3D0" />

    <!-- Itens de Menu -->
    <Group id="menuItemsGroup" translation="[0, 120]">
      <!-- Item 0: Início -->
      <Group id="item_0" translation="[0, 0]">
        <Label id="icon_0" translation="[28, 14]" text="⌂" font="font:MediumBoldSystemFont" color="#FFFFFF" />
        <Label id="label_0" translation="[75, 14]" text="Início" font="font:MediumSystemFont" color="#FFFFFF" visible="false" />
      </Group>

      <!-- Item 1: Ao Vivo -->
      <Group id="item_1" translation="[0, 60]">
        <Label id="icon_1" translation="[28, 14]" text="▶" font="font:MediumBoldSystemFont" color="#94a3b8" />
        <Label id="label_1" translation="[75, 14]" text="Ao Vivo" font="font:MediumSystemFont" color="#94a3b8" visible="false" />
      </Group>

      <!-- Item 2: Acervo -->
      <Group id="item_2" translation="[0, 120]">
        <Label id="icon_2" translation="[28, 14]" text="▦" font="font:MediumBoldSystemFont" color="#94a3b8" />
        <Label id="label_2" translation="[75, 14]" text="Acervo" font="font:MediumSystemFont" color="#94a3b8" visible="false" />
      </Group>

      <!-- Item 3: Guia EPG -->
      <Group id="item_3" translation="[0, 180]">
        <Label id="icon_3" translation="[28, 14]" text="☰" font="font:MediumBoldSystemFont" color="#94a3b8" />
        <Label id="label_3" translation="[75, 14]" text="Guia TV" font="font:MediumSystemFont" color="#94a3b8" visible="false" />
      </Group>

      <!-- Item 4: Eventos -->
      <Group id="item_4" translation="[0, 240]">
        <Label id="icon_4" translation="[28, 14]" text="⚽" font="font:MediumBoldSystemFont" color="#94a3b8" />
        <Label id="label_4" translation="[75, 14]" text="Eventos" font="font:MediumSystemFont" color="#94a3b8" visible="false" />
      </Group>

      <!-- Item 5: Rádios -->
      <Group id="item_5" translation="[0, 300]">
        <Label id="icon_5" translation="[28, 14]" text="♬" font="font:MediumBoldSystemFont" color="#94a3b8" />
        <Label id="label_5" translation="[75, 14]" text="Rádios" font="font:MediumSystemFont" color="#94a3b8" visible="false" />
      </Group>

      <!-- Item 6: Buscar -->
      <Group id="item_6" translation="[0, 360]">
        <Label id="icon_6" translation="[28, 14]" text="⚲" font="font:MediumBoldSystemFont" color="#94a3b8" />
        <Label id="label_6" translation="[75, 14]" text="Buscar" font="font:MediumSystemFont" color="#94a3b8" visible="false" />
      </Group>

      <!-- Item 7: Ajustes -->
      <Group id="item_7" translation="[0, 420]">
        <Label id="icon_7" translation="[28, 14]" text="⚙" font="font:MediumBoldSystemFont" color="#94a3b8" />
        <Label id="label_7" translation="[75, 14]" text="Ajustes" font="font:MediumSystemFont" color="#94a3b8" visible="false" />
      </Group>
    </Group>

    <!-- Versão no rodapé -->
    <Label id="versionLabel" translation="[18, 1030]" text="v2.6.0" font="font:SmallSystemFont" color="#475569" visible="false" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/views/SidebarMenu.brs" />
</component>
