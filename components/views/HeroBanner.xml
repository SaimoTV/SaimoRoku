<?xml version="1.0" encoding="utf-8" ?>
<component name="HeroBanner" extends="Group">
  <interface>
    <field id="featuredItem" type="assocarray" onChange="onItemChange" />
    <field id="playClicked" type="boolean" value="false" alwaysNotify="true" />
    <field id="detailsClicked" type="boolean" value="false" alwaysNotify="true" />
    <field id="focusedButton" type="integer" value="0" />
  </interface>

  <children>
    <!-- Backdrop Full-Bleed 1920x540 -->
    <Poster id="backdropPoster" width="1920" height="540" loadDisplayMode="scaleToZoom" />

    <!-- Camadas de Degrade / Véu estilo TV Box (bg_destaque_lado & bg_destaque_baixo) -->
    <Rectangle width="1920" height="540" color="#0b0e1499" />
    <Rectangle width="1180" height="540" color="#0b0e14D9" />
    <Rectangle translation="[0, 450]" width="1920" height="90" color="#0b0e14" />

    <!-- Textos e Metadados -->
    <Group translation="[80, 75]">
      <!-- Badge de Destaque -->
      <Group translation="[0, 0]">
        <Rectangle id="badgeBg" width="120" height="28" color="#e11d48" />
        <Label id="badgeText" translation="[0, 5]" width="120" text="EM ALTA" font="font:SmallBoldSystemFont" color="#FFFFFF" horizAlign="center" />
      </Group>

      <!-- Título Grande -->
      <Label id="titleLabel" translation="[0, 38]" width="1100" text="Título do Destaque" font="font:LargeBoldSystemFont" color="#FFFFFF" />

      <!-- Metadados em Ciano -->
      <Label id="genreLabel" translation="[0, 98]" width="1100" text="Filmes e Séries • Full HD" font="font:SmallBoldSystemFont" color="#4FE3D0" />

      <!-- Sinopse Detalhada -->
      <Label id="overviewLabel" translation="[0, 132]" width="1050" numLines="3" text="Disponível em alta definição com opções de áudio dublado e legendado." font="font:SmallSystemFont" color="#cbd5e1" wrap="true" />

      <!-- Botões de Ação do Hero -->
      <Group id="buttonsRow" translation="[0, 240]">
        <!-- 0: Assistir -->
        <Group id="playBtnGroup" translation="[0, 0]">
          <Rectangle id="playBtnBorder" translation="[-3, -3]" width="216" height="52" color="#FFFFFF" visible="false" />
          <Rectangle id="playBtnBg" width="210" height="46" color="#4FE3D0" />
          <Label id="playBtnText" translation="[0, 11]" width="210" text="Assistir Agora" font="font:MediumBoldSystemFont" color="#0b0e14" horizAlign="center" />
        </Group>

        <!-- 1: Mais Detalhes -->
        <Group id="detailsBtnGroup" translation="[230, 0]">
          <Rectangle id="detailsBtnBorder" translation="[-3, -3]" width="216" height="52" color="#FFFFFF" visible="false" />
          <Rectangle id="detailsBtnBg" width="210" height="46" color="#1e293b" />
          <Label id="detailsBtnText" translation="[0, 11]" width="210" text="Mais Detalhes" font="font:MediumBoldSystemFont" color="#FFFFFF" horizAlign="center" />
        </Group>
      </Group>
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/components/views/HeroBanner.brs" />
</component>
