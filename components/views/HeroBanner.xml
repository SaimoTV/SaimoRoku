<?xml version="1.0" encoding="utf-8" ?>
<component name="HeroBanner" extends="Group">
  <interface>
    <field id="featuredItem" type="assocarray" onChange="onItemChange" />
    <field id="playClicked" type="boolean" value="false" alwaysNotify="true" />
    <field id="detailsClicked" type="boolean" value="false" alwaysNotify="true" />
    <field id="focusedButton" type="integer" value="0" />
  </interface>

  <children>
    <!-- Imagem de fundo com degradês para o texto ler bem sobre qualquer capa -->
    <Poster id="backdropPoster" width="1920" height="640" loadDisplayMode="scaleToZoom" loadWidth="1280" loadHeight="427" />
    <Poster uri="pkg:/images/degrade_lado.png" width="1920" height="640" />
    <Poster uri="pkg:/images/degrade_baixo.png" width="1920" height="640" />

    <Group translation="[80, 130]">
      <Group>
        <Rectangle id="badgeBg" width="112" height="32" color="#FF4D4F" />
        <Label id="badgeText" width="112" height="32" text="EM ALTA" color="#FFFFFF" horizAlign="center" vertAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="18" /></Label>
      </Group>

      <Label id="titleLabel" translation="[0, 46]" width="1040" height="64" maxLines="1" text="" color="#FFFFFF"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="52" /></Label>
      <Label id="genreLabel" translation="[0, 118]" width="1040" text="" color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="24" /></Label>
      <Label id="overviewLabel" translation="[0, 158]" width="860" height="110" numLines="3" wrap="true" lineSpacing="6" text="" color="#D5DCE5"><Font role="font" uri="pkg:/fonts/Inter-Regular.otf" size="24" /></Label>

      <Group id="buttonsRow" translation="[0, 290]">
        <Group id="playBtnGroup">
          <Rectangle id="playBtnBorder" translation="[-4, -4]" width="238" height="68" color="#FFFFFF" visible="false" />
          <Rectangle id="playBtnBg" width="230" height="60" color="#4FE3D0" />
          <Label id="playBtnText" width="230" height="60" text="Assistir" color="#0b0e14" horizAlign="center" vertAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="26" /></Label>
        </Group>
        <Group id="detailsBtnGroup" translation="[250, 0]">
          <Rectangle id="detailsBtnBorder" translation="[-4, -4]" width="238" height="68" color="#FFFFFF" visible="false" />
          <Rectangle id="detailsBtnBg" width="230" height="60" color="#1e293b" />
          <Label id="detailsBtnText" width="230" height="60" text="Mais detalhes" color="#FFFFFF" horizAlign="center" vertAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="26" /></Label>
        </Group>
      </Group>
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/components/views/HeroBanner.brs" />
</component>
