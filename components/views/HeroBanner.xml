<?xml version="1.0" encoding="utf-8" ?>
<component name="HeroBanner" extends="Group">
  <interface>
    <field id="featuredItem" type="assocarray" onChange="onItemChange" />
    <field id="playClicked" type="boolean" value="false" />
    <field id="detailsClicked" type="boolean" value="false" />
    <field id="focusedButton" type="integer" value="0" />
  </interface>

  <children>
    <Poster id="backdropPoster" width="1920" height="520" loadDisplayMode="scaleToZoom" />
    <Rectangle width="1920" height="520" color="#0b0e14B3" />
    <Rectangle translation="[0, 420]" width="1920" height="100" color="#0b0e14" />

    <!-- Badges e Textos -->
    <Group translation="[120, 100]">
      <Rectangle width="90" height="28" color="#e11d48" />
      <Label translation="[0, 4]" width="90" text="EM ALTA" font="font:SmallBoldSystemFont" color="#FFFFFF" horizAlign="center" />

      <Label id="titleLabel" translation="[0, 45]" width="1000" text="Título do Destaque" font="font:LargeBoldSystemFont" color="#FFFFFF" />
      <Label id="genreLabel" translation="[0, 115]" width="1000" text="Filmes e Séries • HD / 4K" font="font:SmallSystemFont" color="#4FE3D0" />
      <Label id="overviewLabel" translation="[0, 155]" width="900" numLines="3" text="Disponível em alta definição com áudio e legendas." font="font:SmallSystemFont" color="#94a3b8" wrap="true" />

      <!-- Botões de Ação -->
      <Group id="buttonsRow" translation="[0, 270]">
        <Rectangle id="playBtnBg" width="220" height="50" color="#4FE3D0" />
        <Label id="playBtnText" translation="[0, 12]" width="220" text="Assistir Agora" font="font:MediumBoldSystemFont" color="#0b0e14" horizAlign="center" />

        <Rectangle id="detailsBtnBg" translation="[240, 0]" width="220" height="50" color="#1e293b" />
        <Label id="detailsBtnText" translation="[240, 12]" width="220" text="Mais Detalhes" font="font:MediumBoldSystemFont" color="#FFFFFF" horizAlign="center" />
      </Group>
    </Group>
  </children>

  <script type="text/brightscript" uri="pkg:/components/views/HeroBanner.brs" />
</component>
