<?xml version="1.0" encoding="utf-8" ?>
<component name="TopNavBar" extends="Group">
  <interface>
    <field id="selectedIndex" type="integer" value="1" onChange="onIndexChange" />
    <field id="itemSelected" type="string" alwaysNotify="true" />
    <field id="focusDownRequested" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <!-- Fundo da barra superior estilo TV Box -->
    <Rectangle id="navBg" width="1920" height="74" color="#0b0e14" />
    <Rectangle id="navDivider" translation="[0, 73]" width="1920" height="1" color="#1e293b" />

    <!-- Logo no canto esquerdo -->
    <Poster id="navLogo" translation="[40, 16]" width="42" height="42" uri="pkg:/images/icon_hd.png" />
    <Label id="navLogoText" translation="[92, 24]" text="SAIMO TV" font="font:MediumBoldSystemFont" color="#4FE3D0" />

    <!-- Indicador de foco / seleção ativa (Pill) -->
    <Rectangle id="tabPill" translation="[365, 14]" width="100" height="46" color="#1a2436" />
    <Rectangle id="tabBorder" translation="[365, 57]" width="100" height="3" color="#4FE3D0" />

    <!-- Abas Horizontais com larguras proporcionais (Sem cortes ...) -->
    <Group id="tabsGroup">
      <!-- 0: Buscar -->
      <Group id="tab_0" translation="[250, 14]">
        <Label id="label_0" translation="[0, 11]" width="110" text="Buscar" font="font:SmallBoldSystemFont" color="#94a3b8" horizAlign="center" />
      </Group>

      <!-- 1: Início -->
      <Group id="tab_1" translation="[365, 14]">
        <Label id="label_1" translation="[0, 11]" width="100" text="Início" font="font:SmallBoldSystemFont" color="#4FE3D0" horizAlign="center" />
      </Group>

      <!-- 2: Ao Vivo -->
      <Group id="tab_2" translation="[470, 14]">
        <Label id="label_2" translation="[0, 11]" width="125" text="Ao Vivo" font="font:SmallBoldSystemFont" color="#94a3b8" horizAlign="center" />
      </Group>

      <!-- 3: Eventos -->
      <Group id="tab_3" translation="[600, 14]">
        <Label id="label_3" translation="[0, 11]" width="125" text="Eventos" font="font:SmallBoldSystemFont" color="#94a3b8" horizAlign="center" />
      </Group>

      <!-- 4: On Demand -->
      <Group id="tab_4" translation="[730, 14]">
        <Label id="label_4" translation="[0, 11]" width="165" text="On Demand" font="font:SmallBoldSystemFont" color="#94a3b8" horizAlign="center" />
      </Group>

      <!-- 5: Favoritos -->
      <Group id="tab_5" translation="[900, 14]">
        <Label id="label_5" translation="[0, 11]" width="150" text="Favoritos" font="font:SmallBoldSystemFont" color="#94a3b8" horizAlign="center" />
      </Group>

      <!-- 6: Rádios -->
      <Group id="tab_6" translation="[1055, 14]">
        <Label id="label_6" translation="[0, 11]" width="115" text="Rádios" font="font:SmallBoldSystemFont" color="#94a3b8" horizAlign="center" />
      </Group>

      <!-- 7: Ajustes -->
      <Group id="tab_7" translation="[1175, 14]">
        <Label id="label_7" translation="[0, 11]" width="115" text="Ajustes" font="font:SmallBoldSystemFont" color="#94a3b8" horizAlign="center" />
      </Group>
    </Group>

    <!-- Relógio Digital no Canto Direito -->
    <Label id="clockLabel" translation="[1780, 24]" text="--:--" font="font:SmallBoldSystemFont" color="#94a3b8" />
    <Timer id="clockTimer" duration="30" repeat="true" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/views/TopNavBar.brs" />
</component>
