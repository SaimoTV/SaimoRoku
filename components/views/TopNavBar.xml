<?xml version="1.0" encoding="utf-8" ?>
<component name="TopNavBar" extends="Group">
  <interface>
    <field id="selectedIndex" type="integer" value="1" onChange="onIndexChange" />
    <field id="itemSelected" type="string" alwaysNotify="true" />
    <field id="focusDownRequested" type="boolean" alwaysNotify="true" />
  </interface>

  <children>
    <!-- Fundo da barra superior estilo TV Box -->
    <Rectangle id="navBg" width="1920" height="74" color="#0b0e14F0" />
    <Rectangle id="navDivider" translation="[0, 73]" width="1920" height="1" color="#1e293b" />

    <!-- Logo no canto esquerdo -->
    <Poster id="navLogo" translation="[40, 16]" width="42" height="42" uri="pkg:/images/icon_hd.png" />
    <Label id="navLogoText" translation="[92, 24]" text="SAIMO TV" color="#4FE3D0"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="26" /></Label>

    <!-- Indicador de foco / seleção ativa (Pill) -->
    <Rectangle id="tabPill" translation="[365, 14]" width="100" height="46" color="#1a2436" />
    <Rectangle id="tabBorder" translation="[365, 57]" width="100" height="3" color="#4FE3D0" />

    <!-- Abas Horizontais com larguras proporcionais (Sem cortes ...) -->
    <Group id="tabsGroup">
      <!-- 0: Buscar -->
      <Group id="tab_0" translation="[290, 14]">
        <Label id="label_0" translation="[0, 10]" width="118" text="Buscar" color="#94a3b8" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
      </Group>

      <!-- 1: Início -->
      <Group id="tab_1" translation="[416, 14]">
        <Label id="label_1" translation="[0, 10]" width="108" text="Início" color="#4FE3D0" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
      </Group>

      <!-- 2: Ao Vivo -->
      <Group id="tab_2" translation="[532, 14]">
        <Label id="label_2" translation="[0, 10]" width="133" text="Ao Vivo" color="#94a3b8" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
      </Group>

      <!-- 3: Eventos -->
      <Group id="tab_3" translation="[673, 14]">
        <Label id="label_3" translation="[0, 10]" width="133" text="Eventos" color="#94a3b8" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
      </Group>

      <!-- 4: On Demand -->
      <Group id="tab_4" translation="[814, 14]">
        <Label id="label_4" translation="[0, 10]" width="163" text="On Demand" color="#94a3b8" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
      </Group>

      <!-- 5: Favoritos -->
      <Group id="tab_5" translation="[985, 14]">
        <Label id="label_5" translation="[0, 10]" width="148" text="Favoritos" color="#94a3b8" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
      </Group>

      <!-- 6: Rádios -->
      <Group id="tab_6" translation="[1141, 14]">
        <Label id="label_6" translation="[0, 10]" width="123" text="Rádios" color="#94a3b8" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
      </Group>

      <!-- 7: Ajustes -->
      <Group id="tab_7" translation="[1272, 14]">
        <Label id="label_7" translation="[0, 10]" width="133" text="Ajustes" color="#94a3b8" horizAlign="center"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
      </Group>
    </Group>

    <!-- Relógio Digital no Canto Direito -->
    <Label id="clockLabel" translation="[1780, 24]" text="--:--" color="#94a3b8"><Font role="font" uri="pkg:/fonts/Inter-SemiBold.otf" size="22" /></Label>
    <Timer id="clockTimer" duration="30" repeat="true" />
  </children>

  <script type="text/brightscript" uri="pkg:/components/views/TopNavBar.brs" />
</component>
